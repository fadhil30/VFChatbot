// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum ChatbotUseCase {
  GENERAL_AI_AGENT
  CUSTOMER_SUPPORT
  SALES_AGENT
}

enum TrainingSourceType {
  FILE
  TEXT
  WEBSITE
  QNA
}

// --- 1. User (Company Owner) ---
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String
  name          String?
  hasCompletedOnboarding Boolean @default(false)

  chatbots      Chatbot[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --- 2. Chatbot ---
model Chatbot {
  id           String   @id @default(cuid())
  name         String

  primaryColor String   @default("#1a1a1a")
  accentColor  String   @default("#2d2d2d")
  greeting     String   @default("Hello 👋 I'm Beanie, here to help you!")
  useCase      ChatbotUseCase @default(GENERAL_AI_AGENT)

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  visitors        Visitor[]
  trainingSources TrainingSource[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- 3. Visitor & Message ---
model Visitor {
  id        String    @id @default(cuid())
  email     String?
  phone     String?
  chatbotId String
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  isBot     Boolean  @default(false)
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  createdAt DateTime @default(now())
}

// --- 4. Verification Token ---
model VerificationToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}

// --- 5. Training Sources ---
model TrainingSource {
  id         String              @id @default(cuid())
  type       TrainingSourceType
  content    String              // URL, text content, or file path
  fileName   String?             // For file uploads
  fileSize   Int?                // Size in bytes
  question   String?             // For Q&A type
  answer     String?             // For Q&A type

  chatbotId  String
  chatbot    Chatbot             @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}
