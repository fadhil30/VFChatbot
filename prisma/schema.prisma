// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. User (Company Owner) ---
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  
  chatbots  Chatbot[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// --- 2. Chatbot ---
model Chatbot {
  id           String   @id @default(cuid())
  name         String
  
  primaryColor String   @default("#1a1a1a") 
  accentColor  String   @default("#2d2d2d")
  greeting     String   @default("Hello 👋 I'm Beanie, here to help you!")
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  
  visitors     Visitor[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- 3. Visitor & Message ---
model Visitor {
  id        String    @id @default(cuid())
  email     String?
  phone     String?
  chatbotId String
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  isBot     Boolean  @default(false)
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  createdAt DateTime @default(now())
}